{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/naman1911/Mental-Health/schemas/card.schema.json",
  "title": "Topic card",
  "type": "object",
  "required": ["topic_id", "official_name", "plain_title", "also_known_as", "chapter_id", "card_type", "icd10cm_code", "language_convention",
    "one_liner", "in_simple_words", "what_it_can_feel_like", "common_signs", "myths_vs_facts", "how_common", "what_helps", "when_to_reach_out",
    "is_not", "hope_note", "related_topics", "glossary_terms", "safety", "visual", "communities", "sources", "review"],
  "additionalProperties": false,
  "properties": {
    "topic_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "official_name": {"type": "string"},
    "plain_title": {"type": "string", "maxLength": 60},
    "also_known_as": {"type": "array", "items": {"type": "string"}},
    "chapter_id": {"type": "string"},
    "card_type": {"type": "string", "enum": ["condition", "condition-group", "further-study", "cultural-concept", "clinical-focus", "explainer"]},
    "icd10cm_code": {"type": "string"},
    "language_convention": {"type": "string"},
    "language_convention_note": {"type": "string"},
    "one_liner": {"type": "string"},
    "in_simple_words": {"type": "string"},
    "what_it_can_feel_like": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string"}},
    "common_signs": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "string"}},
    "myths_vs_facts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["myth", "fact"], "properties": {"myth": {"type": "string"}, "fact": {"type": "string"}}}},
    "how_common": {"type": "object", "required": ["plain", "figure", "source_ref"], "properties": {"plain": {"type": "string"}, "figure": {"type": "string"}, "source_ref": {"type": "string"}, "note": {"type": "string"}}},
    "what_helps": {"type": "object", "required": ["plain_summary", "evidence_based_options", "self_help_that_supports_care"],
      "properties": {"plain_summary": {"type": "string"}, "evidence_based_options": {"type": "array", "items": {"type": "string"}}, "self_help_that_supports_care": {"type": "array", "items": {"type": "string"}}, "guideline_refs": {"type": "array", "items": {"type": "string"}}}},
    "when_to_reach_out": {"type": "string"},
    "is_not": {"type": "string"},
    "hope_note": {"type": "string"},
    "in_young_people": {"type": "string"},
    "across_cultures": {"type": "string"},
    "strengths_and_differences": {"type": "string"},
    "sub_sections": {"type": "array", "items": {"type": "object", "required": ["title", "text"], "properties": {"title": {"type": "string"}, "icd10cm_code": {"type": "string"}, "text": {"type": "string"}}}},
    "related_topics": {"type": "array", "items": {"type": "string"}},
    "glossary_terms": {"type": "array", "items": {"type": "string"}},
    "safety": {"type": "object", "required": ["sensitivity_level", "show_crisis_strip", "content_notes"],
      "properties": {"sensitivity_level": {"type": "string", "enum": ["standard", "elevated", "high"]}, "show_crisis_strip": {"type": "boolean"}, "content_notes": {"type": "array", "items": {"type": "string"}}},
      "if": {"properties": {"sensitivity_level": {"enum": ["elevated", "high"]}}}, "then": {"properties": {"show_crisis_strip": {"const": true}}}},
    "visual": {"type": "object", "required": ["color_token", "icon", "illustration_prompt", "alt_text"],
      "properties": {"color_token": {"type": "string"}, "icon": {"type": "string"}, "illustration_prompt": {"type": "string"}, "alt_text": {"type": "string", "minLength": 10}}},
    "communities": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "publisher", "url", "accessed", "verification_status"],
      "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "publisher": {"type": "string"}, "year": {"type": "integer"}, "url": {"type": "string", "pattern": "^https://"}, "accessed": {"type": "string", "format": "date"},
        "access_method": {"type": "string", "enum": ["opened", "seen-in-search-results", "not-opened"]}, "verification_status": {"type": "string", "enum": ["verified", "needs_verification"]}, "note": {"type": "string"}}}},
    "review": {"type": "object", "required": ["last_researched", "reading_grade_estimate", "verification_status", "open_questions"],
      "properties": {"last_researched": {"type": "string", "format": "date"}, "reading_grade_estimate": {"type": "number"}, "reading_grade_method": {"type": "string"},
        "verification_status": {"type": "string", "enum": ["verified", "needs_verification", "needs_human_review"]}, "needs_clinician_signoff": {"type": "boolean"}, "open_questions": {"type": "array", "items": {"type": "string"}}}}
  }
}
